                    <td align="center">X </td>
                    <td align="left"> </td>
                    <td align="left"> </td>
                  </tr>
                  <tr>
                    <td align="left">Carga horária de treinamento dos empregados da empresa terceirizada inferior àquela oferecida aos empregados da Cemig. </td>
                    <td align="center">X </td>
                    <td align="center">X </td>
                    <td align="left"> </td>
                  </tr>
                  <tr>
                    <td align="left">Supressão de intervalos para descanso e alimentação de forma costumeira para os trabalhadores da empresa terceirizada. </td>
                    <td align="left"> </td>
                    <td align="center">X </td>
                    <td align="center">X </td>
                  </tr>
                  <tr>
